# ================================================
# 应用配置
# ================================================

# 服务端口
# - 应用监听端口，默认 3000
# - 启动命令：PORT=8080 npm run start:prod
PORT=3003

# ================================================
# AES 加密配置（用于签名校验）
# ================================================
# 警告：生产环境必须修改！

# AES 加密密钥
# - 用于 SignatureGuard 的 AES 解密
# - 必须是 32 字符 base64 编码字符串
# - 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AES_KEY=DYi2KOv9UwabixY4GZCSxX==

# AES 初始向量（IV）
# - AES 加密的 IV 参数
# - 必须正好 16 个字符
AES_ID=FQAziVSKNT1Th5wi

# ================================================
# JWT 配置
# ================================================

# JWT 签名密钥
# - 用于签发和验证 JWT Token
# - 必须是 32 字符 hex 字符串
# - 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=bf6cb8eda375b2d5efdfe1e96cc5bf727771efcb81bb38210f756bdb91703f02

# Access Token 过期时间
# - JWT accessToken 的有效时长
# - 格式：数字 + 单位（s/m/h/d）
# - 示例：15m(15分钟)、1h(1小时)、7d(7天)
JWT_EXPIRES_IN=15m

# Refresh Token 过期时间
# - JWT refreshToken 的有效时长
# - 用于刷新过期的 accessToken
# - 建议比 expiresIn 长很多（如 7d 或 30d）
JWT_REFRESH_EXPIRES_IN=7d

# ================================================
# PostgreSQL 数据库配置
# ================================================

# 数据库主机地址
DATABASE_HOST=localhost

# 数据库端口
DATABASE_PORT=5432

# 数据库用户名
DATABASE_USERNAME=miaozz

# 数据库密码
DATABASE_PASSWORD=123456

# 数据库名称
DATABASE_NAME=miaoshop

# 自动同步（开发 true，生产 false）
# 警告：生产环境务必设为 false！
DATABASE_SYNCHRONIZE=true

# SQL 日志（开发 true，生产 false）
DATABASE_LOGGING=true